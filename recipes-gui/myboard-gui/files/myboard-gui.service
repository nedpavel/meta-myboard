[Unit]
Description=MyBoard Qt Kiosk GUI
After=systemd-user-sessions.service
# Die Oberflaeche belegt tty1. Laeuft dort zusaetzlich ein getty,
# beanspruchen zwei Dienste dieselbe Konsole und systemd beendet diesen
# hier per SIGTERM — der Bildschirm bleibt schwarz, Xorg startet nie.
# Das Image entfernt getty@tty1 bereits (siehe myboard-image.bb); dieser
# Konflikt-Eintrag sichert es zusaetzlich ab, falls der Dienst von Hand
# gestartet wird.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
ExecStart=/usr/bin/xinit /etc/xinitrc -- /usr/bin/Xorg :0 vt1
Restart=on-failure
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
# Ausgaben ins Journal, damit kuenftige Fehler sichtbar sind statt
# spurlos verworfen zu werden.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
