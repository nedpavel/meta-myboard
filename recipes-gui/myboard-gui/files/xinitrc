#!/bin/sh
export QT_QPA_PLATFORM_PLUGIN_PATH=/usr/lib/plugins
export QT_QPA_PLATFORM=xcb

# Hinweis: Hier stand zeitweise eine Warteschleife auf den X-Socket. Sie war
# wirkungslos — der schwarze Bildschirm kam nicht vom Startzeitpunkt, sondern
# davon, dass dem systemd-Dienst HOME fehlte und xinit deshalb abbrach
# (siehe myboard-gui.service). xinit startet diesen Client ohnehin erst,
# wenn der Server bereit ist. Die Absicherung in main.cpp (wartet auf eine
# plausible Bildschirmgroesse) bleibt als Netz bestehen.

exec /usr/bin/myboard-gui
