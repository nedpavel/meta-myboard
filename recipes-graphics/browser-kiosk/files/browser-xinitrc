#!/bin/sh
# X-Sitzung fuer den Browser-Betrieb.
#
# Warum ein Window-Manager: ohne ihn bekommt das GTK-Fenster von Firefox
# nur seine Wunschgroesse, und auch --kiosk kann das Vollbild ohne
# Window-Manager nicht anfordern. matchbox ist winzig und maximiert die
# Anwendung automatisch — das ist der uebliche Weg fuer Kiosk-Betrieb. Die
# Qt-Oberflaeche braucht ihn nicht, weil sie ihre Geometrie selbst setzt.
matchbox-window-manager -use_titlebar no &

# --kiosk: Vollbild ohne Leisten und Menues. --no-remote: kein Anschluss
# an eine schon laufende Instanz. Policies und Voreinstellungen liegen in
# /usr/lib/firefox (policies.json, defaults/pref/kiosk.js).
exec firefox --kiosk --no-remote --profile "${BROWSER_PROFILE:-/var/lib/browser-kiosk}" \
    "${BROWSER_URL:-http://localhost/}"
