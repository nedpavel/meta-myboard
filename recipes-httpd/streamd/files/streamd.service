[Unit]
Description=MyBoard Datenstrom-Empfaenger (TCP)
After=network.target
# php-fpm lauscht auf 127.0.0.1:9000 — deshalb nutzt streamd 9100.
# Der Dienst startete frueher zuerst, belegte 9000 und php-fpm scheiterte
# mit "Address already in use".
After=php-fpm.service
# Verlauf in MariaDB: Datenbank, Tabelle und Benutzer legt
# myboard-db-setup.service an. Laeuft die Datenbank (noch) nicht, puffert
# streamd die Werte und verbindet sich jede Sekunde neu.
Wants=mysqld.service myboard-db-setup.service
After=mysqld.service myboard-db-setup.service

[Service]
# 9100 = Port, 60 = Transaktionen pro Sekunde in MariaDB
ExecStart=/usr/bin/streamd 9100 60
# eigener Benutzer: Anmeldung an MariaDB ueber unix_socket als 'streamd'
User=streamd
Group=streamd
Restart=always
RestartSec=2

# latest.txt liegt im RAM: bei 100 Werten/s waeren das sonst 100
# Flash-Zugriffe pro Sekunde auf die CFast.
RuntimeDirectory=myboard-stream
RuntimeDirectoryMode=0755

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
