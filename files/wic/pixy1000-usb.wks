# Pixy 1000: myboard-image zum Starten vom USB-Stick (Image
# myboard-image-usb) - laeuft ganz vom Stick, die CFast bleibt unberuehrt.
# Boot wie pixy1000-efi.wks (grub-efi ueber den Fallback-Pfad
# EFI/BOOT/bootx64.efi, Microcode als initrd).
#
# Anders als dort: alle Partitionen ueber UUIDs, die wic bei jedem Bau neu
# wuerfelt (root=PARTUUID=..., fstab mit UUID=...). pixy1000-efi.wks
# bindet /boot und /data als /dev/sda1 und /dev/sda3 ein und / ueber
# PARTLABEL=rootfs - vom Stick gestartet waeren das die Partitionen der
# CFast. Eigene Bezeichnungen (usbboot, usbroot, usbdata), damit lsblk
# zeigt, was vom Stick kommt.

part /boot --source bootimg-efi --sourceparams="loader=grub-efi,initrd=microcode.cpio" --ondisk sda --label usbboot --active --align 1024 --fixed-size 64M --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --use-uuid

part / --source rootfs --ondisk sda --fstype=ext4 --label usbroot --align 1024 --use-uuid

part /data --ondisk sda --fstype=ext4 --label usbdata --align 1024 --fixed-size 512M --use-uuid

bootloader --ptable gpt --timeout=3 --append="rootwait console=ttyS0,115200 console=tty0 quiet"
