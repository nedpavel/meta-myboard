# Installer-Stick fuer das Pixy 1000 (Image myboard-installer): bootet per
# UEFI vom USB-Stick und schreibt das mitgelieferte myboard-image auf die
# CFast. Boot wie pixy1000-efi.wks (grub-efi ueber den Fallback-Pfad
# EFI/BOOT/bootx64.efi, Microcode als initrd).
#
# Eigene Partitionsbezeichnungen (instboot, installer): myboard-image
# bootet mit root=PARTLABEL=rootfs - truege der Stick dieselbe
# Bezeichnung wie die CFast, waere nicht sicher, welche der Kernel nimmt.
# Keine fstab-Eintraege: das Root-Dateisystem bleibt nur lesbar (der Stick
# darf am Ende einfach abgezogen werden), /boot braucht der Installer nicht.

part /boot --source bootimg-efi --sourceparams="loader=grub-efi,initrd=microcode.cpio" --ondisk sda --label instboot --active --align 1024 --fixed-size 64M --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --no-fstab-update

part / --source rootfs --ondisk sda --fstype=ext4 --label installer --align 1024 --no-fstab-update

# consoleblank=0: der Bildschirm bleibt waehrend der Installation an.
# quiet loglevel=3: Kernelmeldungen stoeren die Anzeige auf tty1 nicht.
bootloader --ptable gpt --timeout=1 --append="rootwait ro console=ttyS0,115200 console=tty0 quiet loglevel=3 consoleblank=0"
